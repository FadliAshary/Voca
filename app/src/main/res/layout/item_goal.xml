<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/voca_card_bg"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/voca_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/tvItemGoalName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dana Mobil Baru"
                android:textColor="@color/text_adaptive"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvItemGoalPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="0%"
                android:textColor="@color/voca_text_gray"
                android:textSize="12sp" />
        </RelativeLayout>

        <ProgressBar
            android:id="@+id/pbItemGoal"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="12dp"
            android:progress="0"
            android:progressDrawable="@drawable/custom_progress_bar_yellow" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tvItemGoalCurrent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Rp 0 terkumpul"
                android:textColor="@color/voca_text_gray"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/tvItemGoalTarget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Target: Rp 0"
                android:textColor="@color/voca_text_gray"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvItemGoalDeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Deadline: -"
            android:textColor="@color/voca_primary_blue"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>