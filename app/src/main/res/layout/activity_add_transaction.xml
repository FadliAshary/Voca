<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_adaptive">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background_adaptive"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/background_adaptive"
            app:navigationIcon="@drawable/ic_close"
            app:navigationIconTint="@color/text_adaptive">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Tambah Transaksi"
                android:textColor="@color/text_adaptive"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="end"
                android:layout_marginEnd="16dp"
                android:alpha="0.5"
                android:src="@drawable/ic_more" />
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="JUMLAH NOMINAL"
                android:textColor="@color/voca_text_gray"
                android:textSize="12sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbExpense"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Pengeluaran"
                    android:textColor="@color/text_adaptive" />

                <RadioButton
                    android:id="@+id/rbIncome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Pemasukan"
                    android:textColor="@color/text_adaptive" />
            </RadioGroup>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCurrencySymbol"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp"
                    android:textColor="@color/voca_accent_yellow"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@null"
                    android:hint="0"
                    android:inputType="numberDecimal"
                    android:minWidth="40dp"
                    android:textColor="@color/voca_accent_yellow"
                    android:textSize="56sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Categories Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                app:cardBackgroundColor="@color/voca_card_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/voca_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pilih Kategori"
                        android:textColor="@color/text_adaptive"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Expense Categories Grid -->
                    <GridLayout
                        android:id="@+id/gridExpenseCategories"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:columnCount="4"
                        android:alignmentMode="alignMargins"
                        android:columnOrderPreserved="false">

                        <!-- Item Makanan -->
                        <LinearLayout
                            android:id="@+id/catFood"
                            style="@style/CategoryItemStyle">
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardFood"
                                style="@style/CategoryCardStyle">
                                <ImageView
                                    style="@style/CategoryIconStyle"
                                    android:src="@drawable/ic_food" />
                            </com.google.android.material.card.MaterialCardView>
                            <TextView
                                style="@style/CategoryTextStyle"
                                android:text="Makanan" />
                        </LinearLayout>

                        <!-- Item Belanja -->
                        <LinearLayout
                            android:id="@+id/catShopping"
                            style="@style/CategoryItemStyle">
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardShopping"
                                style="@style/CategoryCardStyle">
                                <ImageView
                                    style="@style/CategoryIconStyle"
                                    android:src="@drawable/ic_shopping" />
                            </com.google.android.material.card.MaterialCardView>
                            <TextView
                                style="@style/CategoryTextStyle"
                                android:text="Belanja" />
                        </LinearLayout>

                        <!-- Item Transport -->
                        <LinearLayout
                            android:id="@+id/catTransport"
                            style="@style/CategoryItemStyle">
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardTransport"
                                style="@style/CategoryCardStyle">
                                <ImageView
                                    style="@style/CategoryIconStyle"
                                    android:src="@drawable/ic_transport" />
                            </com.google.android.material.card.MaterialCardView>
                            <TextView
                                style="@style/CategoryTextStyle"
                                android:text="Transport" />
                        </LinearLayout>

                        <!-- Item Tagihan -->
                        <LinearLayout
                            android:id="@+id/catBill"
                            style="@style/CategoryItemStyle">
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardBill"
                                style="@style/CategoryCardStyle">
                                <ImageView
                                    style="@style/CategoryIconStyle"
                                    android:src="@drawable/ic_bill" />
                            </com.google.android.material.card.MaterialCardView>
                            <TextView
                                style="@style/CategoryTextStyle"
                                android:text="Tagihan" />
                        </LinearLayout>

                        <!-- Item Hiburan -->
                        <LinearLayout
                            android:id="@+id/catEntertainment"
                            style="@style/CategoryItemStyle">
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardEntertainment"
                                style="@style/CategoryCardStyle">
                                <ImageView
                                    style="@style/CategoryIconStyle"
                                    android:src="@drawable/ic_entertainment" />
                            </com.google.android.material.card.MaterialCardView>
                            <TextView
                                style="@style/CategoryTextStyle"
                                android:text="Hiburan" />
                        </LinearLayout>

                        <!-- Item Kesehatan -->
                        <LinearLayout
                            android:id="@+id/catHealth"
                            style="@style/CategoryItemStyle">
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardHealth"
                                style="@style/CategoryCardStyle">
                                <ImageView
                                    style="@style/CategoryIconStyle"
                                    android:src="@drawable/ic_health" />
                            </com.google.android.material.card.MaterialCardView>
                            <TextView
                                style="@style/CategoryTextStyle"
                                android:text="Kesehatan" />
                        </LinearLayout>

                        <!-- Item Pendidikan -->
                        <LinearLayout
                            android:id="@+id/catEducation"
                            style="@style/CategoryItemStyle">
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardEducation"
                                style="@style/CategoryCardStyle">
                                <ImageView
                                    style="@style/CategoryIconStyle"
                                    android:src="@drawable/ic_education" />
                            </com.google.android.material.card.MaterialCardView>
                            <TextView
                                style="@style/CategoryTextStyle"
                                android:text="Pendidikan" />
                        </LinearLayout>

                        <!-- Item Rumah -->
                        <LinearLayout
                            android:id="@+id/catHome"
                            style="@style/CategoryItemStyle">
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardHome"
                                style="@style/CategoryCardStyle">
                                <ImageView
                                    style="@style/CategoryIconStyle"
                                    android:src="@drawable/ic_home_nav" />
                            </com.google.android.material.card.MaterialCardView>
                            <TextView
                                style="@style/CategoryTextStyle"
                                android:text="Rumah" />
                        </LinearLayout>

                        <!-- Item Hadiah -->
                        <LinearLayout
                            android:id="@+id/catGift"
                            style="@style/CategoryItemStyle">
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardGift"
                                style="@style/CategoryCardStyle">
                                <ImageView
                                    style="@style/CategoryIconStyle"
                                    android:src="@drawable/ic_gift" />
                            </com.google.android.material.card.MaterialCardView>
                            <TextView
                                style="@style/CategoryTextStyle"
                                android:text="Hadiah" />
                        </LinearLayout>

                        <!-- Item Olahraga -->
                        <LinearLayout
                            android:id="@+id/catSport"
                            style="@style/CategoryItemStyle">
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardSport"
                                style="@style/CategoryCardStyle">
                                <ImageView
                                    style="@style/CategoryIconStyle"
                                    android:src="@drawable/ic_sport" />
                            </com.google.android.material.card.MaterialCardView>
                            <TextView
                                style="@style/CategoryTextStyle"
                                android:text="Olahraga" />
                        </LinearLayout>

                        <!-- Item Travel -->
                        <LinearLayout
                            android:id="@+id/catTravel"
                            style="@style/CategoryItemStyle">
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardTravel"
                                style="@style/CategoryCardStyle">
                                <ImageView
                                    style="@style/CategoryIconStyle"
                                    android:src="@drawable/ic_travel" />
                            </com.google.android.material.card.MaterialCardView>
                            <TextView
                                style="@style/CategoryTextStyle"
                                android:text="Travel" />
                        </LinearLayout>

                        <!-- Item Lainnya -->
                        <LinearLayout
                            android:id="@+id/catMore"
                            style="@style/CategoryItemStyle">
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardMore"
                                style="@style/CategoryCardStyle">
                                <ImageView
                                    style="@style/CategoryIconStyle"
                                    android:src="@drawable/ic_more" />
                            </com.google.android.material.card.MaterialCardView>
                            <TextView
                                style="@style/CategoryTextStyle"
                                android:text="Lainnya" />
                        </LinearLayout>
                    </GridLayout>

                    <!-- Income Categories Grid (Hidden by default) -->
                    <GridLayout
                        android:id="@+id/gridIncomeCategories"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:columnCount="4"
                        android:visibility="gone"
                        android:alignmentMode="alignMargins"
                        android:columnOrderPreserved="false">

                        <!-- Item Gaji -->
                        <LinearLayout
                            android:id="@+id/catSalary"
                            style="@style/CategoryItemStyle">
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardSalary"
                                style="@style/CategoryCardStyle">
                                <ImageView
                                    style="@style/CategoryIconStyle"
                                    android:src="@drawable/ic_wallet" />
                            </com.google.android.material.card.MaterialCardView>
                            <TextView
                                style="@style/CategoryTextStyle"
                                android:text="Gaji" />
                        </LinearLayout>

                        <!-- Item Bonus -->
                        <LinearLayout
                            android:id="@+id/catBonus"
                            style="@style/CategoryItemStyle">
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardBonus"
                                style="@style/CategoryCardStyle">
                                <ImageView
                                    style="@style/CategoryIconStyle"
                                    android:src="@drawable/ic_bonus" />
                            </com.google.android.material.card.MaterialCardView>
                            <TextView
                                style="@style/CategoryTextStyle"
                                android:text="Bonus" />
                        </LinearLayout>

                        <!-- Item Investasi -->
                        <LinearLayout
                            android:id="@+id/catInvestment"
                            style="@style/CategoryItemStyle">
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardInvestment"
                                style="@style/CategoryCardStyle">
                                <ImageView
                                    style="@style/CategoryIconStyle"
                                    android:src="@drawable/ic_budget" />
                            </com.google.android.material.card.MaterialCardView>
                            <TextView
                                style="@style/CategoryTextStyle"
                                android:text="Investasi" />
                        </LinearLayout>

                        <!-- Item Lainnya (Income) -->
                        <LinearLayout
                            android:id="@+id/catMoreIncome"
                            style="@style/CategoryItemStyle">
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardMoreIncome"
                                style="@style/CategoryCardStyle">
                                <ImageView
                                    style="@style/CategoryIconStyle"
                                    android:src="@drawable/ic_more" />
                            </com.google.android.material.card.MaterialCardView>
                            <TextView
                                style="@style/CategoryTextStyle"
                                android:text="Lainnya" />
                        </LinearLayout>
                    </GridLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Details Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/voca_card_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/voca_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:divider="@drawable/divider"
                    android:showDividers="middle">

                    <!-- Date -->
                    <LinearLayout
                        android:id="@+id/btnSelectDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:padding="16dp">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_calendar"
                            app:tint="@color/voca_primary_blue" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tanggal Transaksi"
                                android:textColor="@color/voca_text_gray"
                                android:textSize="11sp" />
                            <TextView
                                android:id="@+id/tvDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hari ini, 24 Mei 2024"
                                android:textColor="@color/text_adaptive"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="@color/voca_text_gray" />
                    </LinearLayout>

                    <!-- Account -->
                    <LinearLayout
                        android:id="@+id/btnSelectAccount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:padding="16dp">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_wallet"
                            app:tint="@color/voca_primary_blue" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pilih Akun"
                                android:textColor="@color/voca_text_gray"
                                android:textSize="11sp" />
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <TextView
                                    android:id="@+id/tvSelectedAccount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Tabungan Utama"
                                    android:textColor="@color/text_adaptive"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/tvAccountStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:background="#DBEAFE"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="2dp"
                                    android:text="CREDIT"
                                    android:textColor="#2563EB"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_arrow_down"
                            app:tint="@color/voca_text_gray" />
                    </LinearLayout>

                    <!-- Note -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:padding="16dp">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_more"
                            app:tint="@color/voca_primary_blue" />
                        <EditText
                            android:id="@+id/etTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:background="@null"
                            android:hint="Tambahkan catatan..."
                            android:textColor="@color/text_adaptive"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Upload Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnUploadReceipt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/voca_card_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/voca_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <ImageView
                        android:id="@+id/ivReceiptPreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:maxHeight="200dp"
                        android:visibility="gone"
                        android:scaleType="centerInside" />

                    <LinearLayout
                        android:id="@+id/layoutUploadPlaceholder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_camera"
                            app:tint="@color/voca_text_gray" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Unggah Struk (Otomatis Scan)"
                            android:textColor="@color/voca_text_gray"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/voca_accent_yellow"
                android:text="Simpan Transaksi"
                android:textColor="@color/voca_dark_blue"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_verified"
                app:iconGravity="textStart"
                app:iconTint="@color/voca_dark_blue" />

            <View
                android:layout_width="match_parent"
                android:layout_height="32dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>